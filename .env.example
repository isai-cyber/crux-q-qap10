APP_NAME="Crux A.I"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/cmms

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cmms_industrial
DB_USER=cmms_user
DB_PASSWORD=change_me

SESSION_NAME=cmms_session
SESSION_LIFETIME=3600

# Proveedor de IA generativa (adaptador en app/services/AIService.php)
# Valores soportados: deepseek | openai | anthropic
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_EMBEDDING_MODEL=text-embedding-3-small

# Tokens de API para integraciones externas (Hermes Agent u otros) se gestionan
# desde el panel de administración, no aquí.

# Configuración Stripe (Suscripciones & Pagos SaaS)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
